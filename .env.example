# Tarayıcıya açılan (herkese açık) Supabase değerleri. Vercel ve .env.local içine ekleyin.
VITE_SUPABASE_URL=https://PROJE-ID.supabase.co
VITE_SUPABASE_ANON_KEY=

# Yalnızca sunucu (api/notify-quote.js). ASLA VITE_ önekiyle eklemeyin.
SUPABASE_SERVICE_ROLE_KEY=

# İsteğe bağlı: e-posta bildirimi. Boşsa talepler yine yönetim panelinde görünür.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
